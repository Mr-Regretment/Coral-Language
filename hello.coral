// classes.coral — OOP: classes, inheritance, and multiple inheritance

public class Shape {
    protected str color;
    protected float area;

    public void __init__(str color) {
        self.color = color;
        self.area  = 0.0;
    }

    public float getArea() {
        return self.area;
    }

    public str getColor() {
        return self.color;
    }

    public void describe() {
        print("Shape[" + self.color + "] area=" + str(round(self.area, 2)));
    }
}

public class Circle extends Shape {
    private float radius;

    public void __init__(str color, float radius) {
        super(color);
        self.radius = radius;
        self.area   = 3.14159 * radius * radius;
    }

    @Override
    public void describe() {
        print("Circle[" + self.color + "] r=" + str(self.radius) + " area=" + str(round(self.area, 2)));
    }
}

public class Rectangle extends Shape {
    private float width;
    private float height;

    public void __init__(str color, float width, float height) {
        super(color);
        self.width  = width;
        self.height = height;
        self.area   = width * height;
    }

    @Override
    public void describe() {
        print("Rectangle[" + self.color + "] " + str(self.width) + "x" + str(self.height) + " area=" + str(self.area));
    }
}

// Multiple inheritance mixin
public class Resizable {
    public void __init__() {
        self._scale = 1.0;
    }

    public void scale(float factor) {
        self._scale = self._scale * factor;
        self.area   = self.area * factor * factor;
        print("Scaled by " + str(factor) + " → new area=" + str(round(self.area, 2)));
    }
}

public class ResizableCircle extends Circle, Resizable {
    public void __init__(str color, float radius) {
        Circle.__init__(self, color, radius);
        Resizable.__init__(self);
    }
}

// --- Main ---
public void main() {
    list<Shape> shapes = [
        new Circle("red", 5.0),
        new Rectangle("blue", 4.0, 6.0),
        new Circle("green", 3.5),
        new Rectangle("gold", 10.0, 2.0)
    ];

    print("=== All Shapes ===");
    foreach(Shape s in shapes) {
        s.describe();
    }

    // Find largest shape
    float maxArea  = 0.0;
    int   maxIndex = 0;
    for(int i = 0; i < len(shapes); i++) {
        if(shapes[i].getArea() > maxArea) {
            maxArea  = shapes[i].getArea();
            maxIndex = i;
        }
    }
    print("\nLargest shape (index " + str(maxIndex) + "):");
    shapes[maxIndex].describe();

    // Multiple inheritance demo
    print("\n=== Resizable Circle ===");
    ResizableCircle rc = new ResizableCircle("purple", 4.0);
    rc.describe();
    rc.scale(2.0);
    rc.describe();
}

main();
